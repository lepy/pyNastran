1                                                                             MARCH   1, 2013  MSC.NASTRAN  6/19/08   PAGE     2
                                                                                                                                    
0        N A S T R A N    E X E C U T I V E    C O N T R O L    E C H O                                                             
0                                                                                                                                   
                                                                                                                                    
                                                                                                                                    
     COMPILE SEMODES SOUIN=MSCSOU LIST NOREF $                                               
     ALTER 207 $                                                                             
     OUTPUT4 MGG//-1/17/2 $                                                                  
     ENDALTER                                                                                
     $                                                                                       
     $                                                                                       
     $                                                                                       
     $                                                                                       
     ID MSC, AFA                                                                             
     TIME 30                                                                                 
     $                                                                                       
     SOL 103                                                                                 
     COMPILE SEMODES SOUIN=MSCSOU LIST NOREF $                                               
     ALTER 215 $                                                                             
     MATGEN EQEXINS/INTEXT/9//LUSETS $ GENERATE EXTERNAL SEQUENCE MATRIX                     
     MPYAD MGG,PHG,/MGHINT $ MGHINT IS THE MGH IN INTERNAL SEQUENCE                          
     MPYAD INTEXT,MGHINT,/MGH/1 $ TRANSFORM MGHINT TO EXTERNAL SEQUENCE                      
     $                                                                                       
     OUTPUT4 MGH//-1/13/2 $ OUTPUT MGH TO UNIT=13                                            
     $                                                                                       
     LAMX  ,,LAMA/LAMAM/-1 $                                                                 
     MATMOD   LAMAM,,,,,/MGEN,/1/4 $                                                         
     MATMOD   LAMAM,,,,,/OMEG,/1/2 $                                                         
     MATMOD   LAMAM,,,,,/FREQ,/1/3 $                                                         
     $                                                                                       
     OUTPUT4  PHG,MGEN,OMEG,FREQ//-1/15/2//6 $                                               
     $                                                                                       
     ENDALTER                                                                                
     $                                                                                       
     CEND                                                                                    

